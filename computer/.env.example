# 和 config.js 二选一；环境变量优先，其次 .env，最后 config.js

# 已部署的 Cloudflare Worker 地址
CLOUDFLARE_WORKER_URL=https://roam.example.workers.dev

# 和 Worker 的 DEVICE_TOKEN secret 一致
DEVICE_TOKEN=

# 可选：这台设备的名字，网页和助理里显示
DEVICE_NAME=

# 可选：一句话描述这台设备，会进助理的上下文
DEVICE_DESCRIPTION=

# 访问密码在云端（npx wrangler secret put ACCESS_PASSWORD），电脑端不再配置
# 调试日志：DEBUG=1 node index.js（只认环境变量）
