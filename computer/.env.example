# 和 config.js 二选一；环境变量优先，其次 .env，最后 config.js

# 已部署的 Cloudflare Worker 地址
CLOUDFLARE_WORKER_URL=https://roam.example.workers.dev

# 和 Worker 的 DEVICE_TOKEN secret 一致
DEVICE_TOKEN=

# 固定连接会话 ID；留空则每次启动随机生成，不能写 default
SESSION_ID=

# 远程网页访问密码；留空则不需要登录校验
SESSION_PASSWORD=

# 写 1 打印 WebSocket 收包摘要
DEBUG=0
