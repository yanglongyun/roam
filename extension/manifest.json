{
  "manifest_version": 3,
  "name": "Roam",
  "description": "让 Roam 助理在你的浏览器里打开网页、读取内容、点击和输入。",
  "version": "0.1.0",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "debugger",
    "tabs",
    "tabGroups",
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Roam"
  }
}
