{
  "manifest_version": 3,
  "name": "Roam",
  "description": "让 Roam 助理操作你的浏览器：所有标签页、页面里的一切（开发者工具协议），以及下载、cookie、历史和书签。",
  "version": "0.2.0",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "debugger",
    "tabs",
    "tabGroups",
    "alarms",
    "storage",
    "downloads",
    "downloads.open",
    "cookies",
    "history",
    "bookmarks",
    "sessions",
    "topSites"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Roam"
  }
}
