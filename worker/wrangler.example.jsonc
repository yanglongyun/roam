/**
 * 复制这份文件到 `wrangler.jsonc`,按注释逐项改成你自己的值。
 * `wrangler.jsonc` 已 gitignore,所有机密只留在本地。
 *
 * 需要准备:
 *   1) Cloudflare account_id
 *        npx wrangler whoami
 *   2) (可选)绑自己的域名 — 先把域名托管进 Cloudflare,再填 routes;
 *        不绑就把整个 "routes" 段删掉,Worker 会自动给一个
 *        roam.<your-subdomain>.workers.dev 的测试地址。
 *
 * 助理的会话 / 消息 / 配置 / 设备登记进 D1。先建库,再把下面的 database_id 换成自己的:
 *   npx wrangler d1 create roam
 *   npx wrangler d1 execute roam --remote --file=server/agent/schema.sql
 *   npx wrangler secret put SETTINGS_KEY    # 用来加密存 API Key
 *   npx wrangler secret put DEVICE_TOKEN    # 电脑端接入凭据，computer/config.js 填同一个值
 * 两个值都用随机串，比如 openssl rand -base64 32。
 *
 * 图片存 R2,是可选的(开通 R2 要绑卡)。不绑就不能收发图片,其余功能照常;
 * 要绑的话先 npx wrangler r2 bucket create roam,再把下面 r2_buckets 段的注释去掉。
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "roam",
	"account_id": "<YOUR_CLOUDFLARE_ACCOUNT_ID>",
	"main": "server/index.js",
	"compatibility_date": "2025-09-12",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/ws"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "roam",
			"database_id": "<YOUR_D1_DATABASE_ID>"
		}
	],
	// "r2_buckets": [
	// 	{
	// 		"binding": "IMAGES",
	// 		"bucket_name": "roam"
	// 	}
	// ],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "TerminalSessionManager",
				"name": "TERMINAL_SESSION_MANAGER"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["TerminalSessionManager"]
		}
	],
	"observability": {
		"enabled": true
	},

	// 不绑自定义域名就把整个 "routes" 段删掉,Cloudflare 会自动给
	// roam.<your-subdomain>.workers.dev 的测试地址。
	// 要绑自己的域名(如 roam.example.com):
	//   1) 先在 Cloudflare 控制台 → Websites 把域名托管进来
	//   2) 下面 pattern 换成要绑的域名
	//   3) npm run deploy 之后 Cloudflare 会自动配 DNS + 证书
	"routes": [
		{
			"pattern": "<YOUR_DOMAIN>",
			"custom_domain": true
		}
	]
}
